# Copy to .env. Compose defaults work without a paid API key.
DATABASE_URL=postgresql+asyncpg://lenny:lenny_local_only@localhost:5433/lenny
POSTGRES_PASSWORD=lenny_local_only
DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
PI_AGENT_URL=http://localhost:8001
# Hard maximum per SDK generation request in the Pi service.
PI_AGENT_MAX_TIMEOUT_MS=360000
# Optional: leave empty for Ollama-only use. Restart API after setting locally.
# A configured key gets an authenticated model-access check, not a green generation claim.
MODEL_TIMEOUT_SECONDS=360
MODEL_MAX_TOKENS=3500
OLLAMA_CONTEXT_TOKENS=8192
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR defaults to this repository's data/embeddings directory.
RAG_TOP_K=8
RAG_MIN_SCORE=0.45
CONTEXT_MESSAGES=8
CONTEXT_CHAR_LIMIT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRANSCRIPT_REPOSITORY=https://github.com/ChatPRD/lennys-podcast-transcripts
TRANSCRIPT_REVISION=main
# Demo ingestion uses this manifest's explicitly licensed source list.
DEMO_SOURCES_FILE=evals/demo-sources.json
# Independently authored long-form growth essay instructions.
SHIP30_GUIDE_FILE=skills/growth-essay/ESSAY_GUIDE.md
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=90
